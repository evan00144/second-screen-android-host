;
; USB Monitor Transport IddCx virtual display driver
;

[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=UsbMonitorIddCx.cat
DriverVer=09/25/2026,1.16.0.0
PnpLockDown=1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...19041,NTamd64.10.0...22000

[Standard.NTamd64.10.0...19041]
%DeviceName%=UsbMonitorIddCx_Install,Root\UsbMonitorTransportIddCx

[Standard.NTamd64.10.0...22000]
%DeviceName%=UsbMonitorIddCx_Install,Root\UsbMonitorTransportIddCx

[SourceDisksFiles]
UsbMonitorIddCx.dll=1

[SourceDisksNames]
1=%DiskName%

[UsbMonitorIddCx_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UsbMonitorIddCx_CopyFiles

[UsbMonitorIddCx_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=UsbMonitorIddCx_HardwareSettings

[UsbMonitorIddCx_HardwareSettings]
HKR,,UpperFilters,%REG_MULTI_SZ%,IndirectKmd
HKR,"WUDF",DeviceGroupId,%REG_SZ%,UsbMonitorTransportIddCxGroup

[UsbMonitorIddCx_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[UsbMonitorIddCx_Install.NT.Wdf]
UmdfService=UsbMonitorIddCx,UsbMonitorIddCx_ServiceInstall
UmdfServiceOrder=UsbMonitorIddCx
UmdfKernelModeClientPolicy=AllowKernelModeClients

[UsbMonitorIddCx_ServiceInstall]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\UsbMonitorIddCx.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
UsbMonitorIddCx_CopyFiles=12,UMDF

[UsbMonitorIddCx_CopyFiles]
UsbMonitorIddCx.dll

[Strings]
ManufacturerName="USB Monitor Transport"
DeviceName="USB Monitor Transport Virtual Display"
DiskName="USB Monitor Transport Driver"
REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
